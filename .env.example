# Postgres connection string (get this from Neon/Supabase)
DATABASE_URL=postgres://user:password@host/dbname

# Razorpay keys (Settings -> API Keys in Razorpay dashboard)
# Use test keys (rzp_test_...) until your account is KYC-approved for live payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
